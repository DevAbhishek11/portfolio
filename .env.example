APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=portfolio
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Dev Abhishek"

# ── Server maintenance routes (routes/web.php "/server/*") ────────────────────
# Generate with: php artisan tinker --execute="echo bin2hex(random_bytes(32));"
# Leave blank to disable these routes entirely.
MAINTENANCE_TOKEN=

# ── AI live chat (OpenRouter) ───────────────────────────────────────────────
# Free account: https://openrouter.ai. Tested against several free models —
# this one reliably follows the "use only the provided context" instruction,
# where some others (including the openrouter/free auto-router) sometimes
# ignore the injected context and claim they don't have it. If this slug
# gets retired, check https://openrouter.ai/collections/free-models and test
# a replacement the same way before switching (weaker free models are prone
# to hallucinating or ignoring instructions). Leave OPENROUTER_API_KEY blank
# to keep the chat widget hidden/disabled.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# ── Portfolio Config ──────────────────────────────────────────────────────────
PORTFOLIO_SITE_NAME="Abhishek Prajapati"
PORTFOLIO_TAGLINE="Full Stack Developer | MERN Stack Developer"
PORTFOLIO_EMAIL="dev.abhishek.ap11@gmail.com"
PORTFOLIO_PHONE="+91 705 629 8363"
PORTFOLIO_LOCATION="Chandigarh, India"
PORTFOLIO_META_DESC="Full-stack developer specializing in Laravel, React, and Node.js — building scalable web applications, REST APIs, and SaaS platforms for clients worldwide."
PORTFOLIO_META_KEYWORDS="Laravel developer, full stack developer, MERN stack developer, React developer, Next.js developer, Node.js developer, PHP developer, hire Laravel developer, freelance web developer, REST API development, TypeScript developer, web application development"
PORTFOLIO_OG_IMAGE="/assets/images/og/default.jpg"

# ── Social Links ──────────────────────────────────────────────────────────────
PORTFOLIO_GITHUB="https://github.com/yourusername"
PORTFOLIO_LINKEDIN="https://linkedin.com/in/yourusername"
PORTFOLIO_TWITTER="https://twitter.com/yourusername"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
